load("//packages/compiler-cli/test/compliance/partial:partial_compliance_goldens.bzl", "compatibility_test_matrix", "partial_compliance_golden")
load("//tools:defaults.bzl", "copy_to_bin")

package(default_visibility = ["//packages/compiler-cli/test/compliance:__subpackages__"])

copy_to_bin(
    name = "test_cases",
    srcs = glob(["*/**"]),
)

_TYPESCRIPT_COMPATIBILITY_VERSIONS = [
    "4.8",
    "4.9",
    "5.0",
    "5.1",
    "5.2",
    "5.3",
    "5.4",
    "5.5",
    "5.6",
    "5.7",
    "5.8",
    "5.9",
    "6.0",
    "6.1",
    "6.2",
    "6.3",
    "6.4",
    "6.5",
]

_MODULE_FORMATS = [
    "commonjs",
    "esm",
    "system",
    "umd",
]

_COMPILATION_MODES = [
    "full",
    "partial",
]

_LINKER_MODES = [
    "linked",
    "unlinked",
]

compatibility_test_matrix(
    name = "compatibility_test_matrix",
    srcs = glob(["*/**"]),
    typescript_versions = _TYPESCRIPT_COMPATIBILITY_VERSIONS,
    module_formats = _MODULE_FORMATS,
    compilation_modes = _COMPILATION_MODES,
    linker_modes = _LINKER_MODES,
)

[partial_compliance_golden(filePath = path) for path in glob(
    include = ["**/TEST_CASES.json"],
)]
